<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="autoTimer_id">autoTimer</variable>
  </variables>
  <block type="procedures_defnoreturn" id="rev26_0001" deletable="false" x="40" y="40">
    <field name="NAME">runOpMode</field>
    <comment pinned="false" h="65" w="410">FTC BIOBUZZ 2026-27 REV Starter Bot Auto. Face the intake toward the starting wall. Test directions and launch power before competition.</comment>
    <statement name="STACK">
      <block type="comment" id="rev26_0002">
        <field name="COMMENT">REV 2026-27 config: leftDrive, rightDrive, intakeMotor, flywheel, crServo, pollenServo.</field>
        <next>
          <block type="dcMotor_setProperty_Direction" id="rev26_0003">
            <field name="IDENTIFIER">rightDriveAsDcMotor</field>
            <field name="PROP">Direction</field>
            <data>{"IDENTIFIER": "rightDrive"}</data>
            <value name="VALUE">
              <block type="dcMotor_typedEnum_direction" id="rev26_0004">
                <field name="DIRECTION">REVERSE</field>
              </block>
            </value>
            <next>
              <block type="dcMotor_setProperty_RunMode" id="rev26_0005">
                <field name="IDENTIFIER">flywheelAsDcMotor</field>
                <field name="PROP">Mode</field>
                <data>{"IDENTIFIER": "flywheel"}</data>
                <value name="VALUE">
                  <block type="dcMotor_typedEnum_runMode" id="rev26_0006">
                    <field name="RUN_MODE">RUN_USING_ENCODER</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="rev26_0007">
                    <field name="VAR" id="autoTimer_id">autoTimer</field>
                    <value name="VALUE">
                      <block type="elapsedTime2_create" id="rev26_0008"/>
                    </value>
                    <next>
                      <block type="dcMotor_setDualProperty" id="rev26_0009">
                        <field name="PROP">Power</field>
                        <field name="IDENTIFIER1">leftDriveAsDcMotor</field>
                        <field name="IDENTIFIER2">rightDriveAsDcMotor</field>
                        <data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data>
                        <value name="VALUE1">
                          <block type="math_number" id="rev26_0010">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <value name="VALUE2">
                          <block type="math_number" id="rev26_0011">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="dcMotor_setProperty_Number" id="rev26_0012">
                            <field name="IDENTIFIER">intakeMotorAsDcMotor</field>
                            <field name="PROP">Power</field>
                            <data>{"IDENTIFIER":"intakeMotor"}</data>
                            <value name="VALUE">
                              <block type="math_number" id="rev26_0013">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="dcMotor_setProperty_Number" id="rev26_0014">
                                <field name="IDENTIFIER">flywheelAsDcMotor</field>
                                <field name="PROP">Power</field>
                                <data>{"IDENTIFIER":"flywheel"}</data>
                                <value name="VALUE">
                                  <block type="math_number" id="rev26_0015">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="crServo_setProperty_Number" id="rev26_0016">
                                    <field name="IDENTIFIER">crServoAsCRServo</field>
                                    <field name="PROP">Power</field>
                                    <data>{"IDENTIFIER":"crServo"}</data>
                                    <value name="VALUE">
                                      <block type="math_number" id="rev26_0017">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="telemetry_addTextData_All" id="rev26_0018">
                                        <value name="KEY">
                                          <block type="text" id="rev26_0019">
                                            <field name="TEXT">Stage</field>
                                          </block>
                                        </value>
                                        <value name="TEXT">
                                          <block type="text" id="rev26_0020">
                                            <field name="TEXT">Ready - face intake at wall</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="telemetry_update" id="rev26_0021">
                                            <next>
                                              <block type="linearOpMode_waitForStart" id="rev26_0022">
                                                <next>
                                                  <block type="controls_if" id="rev26_0023">
                                                    <value name="IF0">
                                                      <block type="linearOpMode_opModeIsActive" id="rev26_0024"/>
                                                    </value>
                                                    <statement name="DO0">
                                                      <block type="servo_setProperty_Number" id="rev26_0025">
                                                        <field name="IDENTIFIER">pollenServoAsServo</field>
                                                        <field name="PROP">Position</field>
                                                        <data>{"IDENTIFIER":"pollenServo"}</data>
                                                        <value name="VALUE">
                                                          <block type="math_number" id="rev26_0026">
                                                            <field name="NUM">1</field>
                                                          </block>
                                                        </value>
                                                        <next>
                                                          <block type="comment" id="rev26_0027">
                                                            <field name="COMMENT">Move away from the wall: both drives at -0.25 for 0.7 seconds. TUNE on your field.</field>
                                                            <next>
                                                              <block type="elapsedTime2_reset" id="rev26_0028">
                                                                <value name="ELAPSED_TIME">
                                                                  <block type="variables_get" id="rev26_0029">
                                                                    <field name="VAR" id="autoTimer_id">autoTimer</field>
                                                                  </block>
                                                                </value>
                                                                <next>
                                                                  <block type="dcMotor_setDualProperty" id="rev26_0030">
                                                                    <field name="PROP">Power</field>
                                                                    <field name="IDENTIFIER1">leftDriveAsDcMotor</field>
                                                                    <field name="IDENTIFIER2">rightDriveAsDcMotor</field>
                                                                    <data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data>
                                                                    <value name="VALUE1">
                                                                      <block type="math_number" id="rev26_0031">
                                                                        <field name="NUM">-0.25</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="VALUE2">
                                                                      <block type="math_number" id="rev26_0032">
                                                                        <field name="NUM">-0.25</field>
                                                                      </block>
                                                                    </value>
                                                                    <next>
                                                                      <block type="controls_whileUntil" id="rev26_0033">
                                                                        <field name="MODE">WHILE</field>
                                                                        <value name="BOOL">
                                                                          <block type="logic_operation" id="rev26_0034">
                                                                            <field name="OP">AND</field>
                                                                            <value name="A">
                                                                              <block type="linearOpMode_opModeIsActive" id="rev26_0035"/>
                                                                            </value>
                                                                            <value name="B">
                                                                              <block type="logic_compare" id="rev26_0036">
                                                                                <field name="OP">LT</field>
                                                                                <value name="A">
                                                                                  <block type="elapsedTime2_getProperty_Number" id="rev26_0037">
                                                                                    <field name="PROP">Seconds</field>
                                                                                    <value name="ELAPSED_TIME">
                                                                                      <block type="variables_get" id="rev26_0038">
                                                                                        <field name="VAR" id="autoTimer_id">autoTimer</field>
                                                                                      </block>
                                                                                    </value>
                                                                                  </block>
                                                                                </value>
                                                                                <value name="B">
                                                                                  <block type="math_number" id="rev26_0039">
                                                                                    <field name="NUM">0.7</field>
                                                                                  </block>
                                                                                </value>
                                                                              </block>
                                                                            </value>
                                                                          </block>
                                                                        </value>
                                                                        <statement name="DO">
