                                                                        </statement>
                                                                        <next>
                                                                          <block type="dcMotor_setDualProperty" id="rev26_0041">
                                                                            <field name="PROP">Power</field>
                                                                            <field name="IDENTIFIER1">leftDriveAsDcMotor</field>
                                                                            <field name="IDENTIFIER2">rightDriveAsDcMotor</field>
                                                                            <data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data>
                                                                            <value name="VALUE1">
                                                                              <block type="math_number" id="rev26_0042">
                                                                                <field name="NUM">0</field>
                                                                              </block>
                                                                            </value>
                                                                            <value name="VALUE2">
                                                                              <block type="math_number" id="rev26_0043">
                                                                                <field name="NUM">0</field>
                                                                              </block>
                                                                            </value>
                                                                            <next>
                                                                              <block type="comment" id="rev26_0044">
                                                                                <field name="COMMENT">Start flywheel and spin up for 2.0 seconds. Power-based starter code, tune launch range.</field>
                                                                                <next>
                                                                                  <block type="dcMotor_setProperty_Number" id="rev26_0045">
                                                                                    <field name="IDENTIFIER">flywheelAsDcMotor</field>
                                                                                    <field name="PROP">Power</field>
                                                                                    <data>{"IDENTIFIER":"flywheel"}</data>
                                                                                    <value name="VALUE">
                                                                                      <block type="math_number" id="rev26_0046">
                                                                                        <field name="NUM">0.78</field>
                                                                                      </block>
                                                                                    </value>
                                                                                    <next>
                                                                                      <block type="elapsedTime2_reset" id="rev26_0047">
